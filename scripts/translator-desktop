#!/usr/bin/bash -p
set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
project_root="$(cd -- "$(dirname -- "${script_path}")/.." && pwd)"
unit_source="${project_root}/systemd/translator.service"
config_root="$(/usr/bin/systemd-path user-configuration)"
systemd_user_dir="${config_root}/systemd/user"
autostart_dir="${config_root}/autostart"
unit_target="${systemd_user_dir}/translator.service"
autostart_target="${autostart_dir}/translator-ui.desktop"
user_bin_dir="${HOME}/.local/bin"
command_target="${user_bin_dir}/translator"
script_target="${project_root}/scripts/translator-desktop"
ui_binary_source="${project_root}/target/release/translator-ui"
ui_binary_target="${user_bin_dir}/translator-ui"
daemon_binary_source="${project_root}/target/release/translator-daemon"
daemon_binary_target="${user_bin_dir}/translator-daemon"
ui_project_dir="${project_root}/apps/translator-ui"

usage() {
  printf 'usage: %s {install|up|start|stop|down|restart|status|logs|disable|uninstall}\n' "${0##*/}" >&2
}

service_environment_runtime_code='
import hashlib
import os
import re
import stat
import sys

MAX_ENVIRONMENT_BYTES = 65536
MAX_ENVIRONMENT_LINES = 256
ALLOWED_KEYS = frozenset({
    "OPENAI_API_KEY",
    "TRANSLATOR_ASR_MODEL_ID",
    "TRANSLATOR_CONTINUATION_TAIL_RMS",
    "TRANSLATOR_CUDA_LIBRARY_PATH",
    "TRANSLATOR_DISABLE_HEADPHONE_AEC",
    "TRANSLATOR_ENABLE_HEADPHONE_AEC",
    "TRANSLATOR_HEADPHONE_SINK",
    "TRANSLATOR_LOCAL_RUNTIME_MODE",
    "TRANSLATOR_MODEL_CACHE_ROOT",
    "TRANSLATOR_PYTHON",
    "TRANSLATOR_SIDECAR_ROOT",
    "TRANSLATOR_VAD_ADAPTIVE_SILENCE_MS",
    "TRANSLATOR_VAD_CONFIRMATION_FRAMES",
    "TRANSLATOR_VAD_MAX_UTTERANCE_MS",
    "TRANSLATOR_VAD_MIN_RMS",
    "TRANSLATOR_VAD_MIN_UTTERANCE_MS",
})
KEY_PATTERN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")


def refuse(message):
    print(message, file=sys.stderr)
    raise SystemExit(78)


def checked_open(path, flags, message, *, dir_fd=None, mode=None):
    try:
        if mode is None:
            return os.open(path, flags, dir_fd=dir_fd)
        return os.open(path, flags, mode, dir_fd=dir_fd)
    except OSError:
        refuse(message)


def check_directory(fd, expected_mode, exact_mode):
    info = os.fstat(fd)
    mode = stat.S_IMODE(info.st_mode)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
        refuse("refusing unsafe service environment directory")
    if exact_mode and mode != expected_mode:
        refuse("refusing unsafe service environment directory mode")
    if not exact_mode and mode & 0o022:
        refuse("refusing attacker-writable service configuration root")


def check_environment_file(fd):
    info = os.fstat(fd)
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != os.geteuid()
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_nlink != 1
    ):
        refuse("refusing unsafe service environment file")
    if info.st_size > MAX_ENVIRONMENT_BYTES:
        refuse("refusing oversized service environment file")
    return info


def signature(info):
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def read_stable_file(fd, before):
    def read_once():
        chunks = []
        remaining = MAX_ENVIRONMENT_BYTES + 1
        while remaining:
            chunk = os.read(fd, remaining)
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        return b"".join(chunks)

    data = read_once()
    middle = os.fstat(fd)
    os.lseek(fd, 0, os.SEEK_SET)
    verification_data = read_once()
    after = os.fstat(fd)
    expected_size = before.st_size
    if (
        len(data) > MAX_ENVIRONMENT_BYTES
        or len(data) != expected_size
        or len(verification_data) != expected_size
    ):
        refuse("refusing unstable service environment file")
    if signature(before) != signature(middle) or signature(middle) != signature(after):
        refuse("refusing service environment file changed during read")
    if hashlib.sha256(data).digest() != hashlib.sha256(verification_data).digest():
        refuse("refusing service environment content changed during read")
    return data


def parse_environment(data):
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        refuse("refusing non-UTF-8 service environment file")
    if "\x00" in text:
        refuse("refusing NUL in service environment file")

    lines = text.split("\n")
    if len(lines) > MAX_ENVIRONMENT_LINES:
        refuse("refusing too many service environment lines")
    parsed = {}
    for line in lines:
        if line.endswith("\r"):
            line = line[:-1]
        if "\r" in line:
            refuse("refusing malformed service environment line")
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator or KEY_PATTERN.fullmatch(key) is None:
            refuse("refusing malformed service environment line")
        if key not in ALLOWED_KEYS:
            refuse("unsupported service environment key")
        if key in parsed:
            refuse("refusing duplicate service environment key")
        parsed[key] = value
    return parsed


def open_environment_tree(root, create):
    if not os.path.isabs(root):
        refuse("refusing non-absolute service configuration root")
    if create:
        previous_umask = os.umask(0o077)
        try:
            os.makedirs(root, mode=0o700, exist_ok=True)
        except OSError:
            refuse("failed to create service configuration root safely")
        finally:
            os.umask(previous_umask)

    directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    root_fd = checked_open(
        root,
        directory_flags,
        "refusing unsafe service configuration root",
    )
    check_directory(root_fd, 0, False)

    if create:
        try:
            os.mkdir("translator", mode=0o700, dir_fd=root_fd)
        except FileExistsError:
            pass
        except OSError:
            refuse("failed to create service environment directory safely")
    environment_directory_fd = checked_open(
        "translator",
        directory_flags,
        "refusing unsafe service environment directory",
        dir_fd=root_fd,
    )
    check_directory(environment_directory_fd, 0o700, True)

    file_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
    if create:
        try:
            environment_fd = os.open(
                "environment",
                file_flags | os.O_CREAT | os.O_EXCL,
                0o600,
                dir_fd=environment_directory_fd,
            )
            os.fchmod(environment_fd, 0o600)
        except FileExistsError:
            environment_fd = checked_open(
                "environment",
                file_flags,
                "refusing unsafe service environment file",
                dir_fd=environment_directory_fd,
            )
        except OSError:
            refuse("failed to create service environment file safely")
    else:
        environment_fd = checked_open(
            "environment",
            file_flags,
            "refusing unsafe service environment file",
            dir_fd=environment_directory_fd,
        )
    return root_fd, environment_directory_fd, environment_fd


mode = sys.argv[1] if len(sys.argv) > 1 else ""
root = sys.argv[2] if len(sys.argv) > 2 else ""
if mode not in {"prepare", "exec"}:
    refuse("invalid service environment runtime mode")

root_fd, environment_directory_fd, environment_fd = open_environment_tree(
    root, mode == "prepare"
)
environment_info = check_environment_file(environment_fd)
environment_data = read_stable_file(environment_fd, environment_info)
service_environment = parse_environment(environment_data)
if mode == "prepare":
    os.close(environment_fd)
    os.close(environment_directory_fd)
    os.close(root_fd)
    raise SystemExit(0)

if len(sys.argv) != 4:
    refuse("invalid daemon wrapper arguments")
daemon_path = sys.argv[3]
expected_daemon_path = os.path.join(
    os.environ.get("HOME", ""), ".local", "bin", "translator-daemon"
)
if daemon_path != expected_daemon_path or not os.path.isabs(daemon_path):
    refuse("refusing unexpected translator daemon path")

os.close(environment_fd)
os.close(environment_directory_fd)
os.close(root_fd)

daemon_fd = checked_open(
    daemon_path,
    os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
    "refusing unsafe translator daemon executable",
)
daemon_info = os.fstat(daemon_fd)
daemon_mode = stat.S_IMODE(daemon_info.st_mode)
if (
    not stat.S_ISREG(daemon_info.st_mode)
    or daemon_info.st_uid != os.geteuid()
    or daemon_mode & 0o100 == 0
    or daemon_mode & 0o022
):
    refuse("refusing unsafe translator daemon executable")

daemon_environment = dict(os.environ)
for inherited_key in tuple(daemon_environment):
    if (
        inherited_key.startswith("LD_")
        or inherited_key.startswith("PYTHON")
        or inherited_key in {"BASH_ENV", "ENV", "SHELLOPTS"}
    ):
        daemon_environment.pop(inherited_key, None)
daemon_environment.update(service_environment)
os.execve(daemon_fd, [daemon_path], daemon_environment)
'

prepare_service_environment() {
  /usr/bin/python3 -I -c "${service_environment_runtime_code}" prepare "${config_root}"
}

run_daemon_with_service_environment() {
  exec /usr/bin/python3 -I -c "${service_environment_runtime_code}" exec "${1}" "${2}"
}

write_autostart() {
  install -d -m 700 "${autostart_dir}"
  temporary="$(mktemp "${autostart_dir}/.translator-ui.desktop.XXXXXX")"
  chmod 600 "${temporary}"
  {
    printf '%s\n' '[Desktop Entry]'
    printf '%s\n' 'Type=Application'
    printf '%s\n' 'Name=Translator'
    printf '%s\n' 'Comment=Translator tray and status UI'
    printf '%s\n' 'Exec=translator-ui'
    printf '%s\n' 'TryExec=translator-ui'
    printf '%s\n' 'Terminal=false'
    printf '%s\n' 'X-GNOME-Autostart-enabled=true'
  } >"${temporary}"
  mv "${temporary}" "${autostart_target}"
}

install_command() {
  install -d -m 700 "${user_bin_dir}"

  if [ -e "${command_target}" ] || [ -L "${command_target}" ]; then
    existing_target="$(readlink -f -- "${command_target}" 2>/dev/null || true)"
    if [ "${existing_target}" != "${script_target}" ]; then
      printf '%s\n' "refusing to overwrite existing translator command: ${command_target}" >&2
      exit 73
    fi
  fi

  ln -sfn -- "${script_target}" "${command_target}"
}

build_ui_binary_if_available() {
  if [ ! -f "${ui_project_dir}/package.json" ]; then
    return 1
  fi

  if ! command -v bun >/dev/null 2>&1; then
    return 1
  fi

  (cd "${ui_project_dir}" && bun run tauri build --no-bundle >/dev/null)
}

install_ui_binary_if_available() {
  if ! build_ui_binary_if_available; then
    printf '%s\n' 'translator-ui install skipped: tauri build is unavailable or failed' >&2
    return 0
  fi
  if [ ! -x "${ui_binary_source}" ]; then
    printf '%s\n' "translator-ui install skipped: ${ui_binary_source} was not produced" >&2
    return 0
  fi

  install -d -m 700 "${user_bin_dir}"
  temporary="$(mktemp "${user_bin_dir}/.translator-ui.XXXXXX")"
  if ! install -m 755 "${ui_binary_source}" "${temporary}"; then
    [ ! -e "${temporary}" ] || unlink "${temporary}"
    printf '%s\n' "translator-ui install skipped: failed to copy ${ui_binary_source}" >&2
    return 0
  fi
  mv "${temporary}" "${ui_binary_target}"
}

install_daemon_binary_if_available() {
  if [ ! -x "${daemon_binary_source}" ]; then
    return 0
  fi

  install -d -m 700 "${user_bin_dir}"
  temporary="$(mktemp "${user_bin_dir}/.translator-daemon.XXXXXX")"
  if ! install -m 755 "${daemon_binary_source}" "${temporary}"; then
    [ ! -e "${temporary}" ] || unlink "${temporary}"
    printf '%s\n' "translator-daemon install skipped: failed to copy ${daemon_binary_source}" >&2
    return 0
  fi
  mv "${temporary}" "${daemon_binary_target}"
}

remove_command_if_owned() {
  if [ -L "${command_target}" ]; then
    existing_target="$(readlink -f -- "${command_target}" 2>/dev/null || true)"
    if [ "${existing_target}" = "${script_target}" ]; then
      rm -f -- "${command_target}"
    fi
  fi
}

install_unit() {
  prepare_service_environment
  test -f "${unit_source}"
  install_command
  install_daemon_binary_if_available
  install_ui_binary_if_available
  install -d -m 700 "${systemd_user_dir}"
  install -m 600 "${unit_source}" "${unit_target}"
  write_autostart
  systemctl --user daemon-reload
  systemctl --user enable translator.service
}

unit_file_loaded() {
  systemctl --user list-unit-files translator.service --no-legend 2>/dev/null | grep -q '^translator\.service'
}

start_unit_installing_if_needed() {
  prepare_service_environment
  install_command
  install_daemon_binary_if_available
  install_ui_binary_if_available
  if ! unit_file_loaded; then
    install_unit
  fi
  prepare_service_environment
  systemctl --user start translator.service
}

wait_for_daemon_api() {
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  attempt=0
  while [ "${attempt}" -lt 50 ]; do
    if curl -sS -m 0.5 -o /dev/null http://127.0.0.1:47681/v1/status >/dev/null 2>&1; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done

  printf '%s\n' 'daemon API did not become ready before UI launch; continuing' >&2
}

ensure_ui_running() {
  if pgrep -u "$(id -u)" -x translator-ui >/dev/null 2>&1; then
    return 0
  fi

  if [ -x "${ui_binary_target}" ]; then
    ui_command="${ui_binary_target}"
  elif ui_command="$(command -v translator-ui 2>/dev/null)"; then
    :
  else
    printf '%s\n' 'translator-ui is not in PATH; desktop UI launch skipped' >&2
    return 0
  fi

  if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    printf '%s\n' 'no DISPLAY or WAYLAND_DISPLAY; desktop UI launch skipped' >&2
    return 0
  fi

  if ! setsid -f "${ui_command}" >/dev/null 2>&1; then
    printf '%s\n' 'translator-ui launch failed; daemon remains running' >&2
  fi
}

cleanup_audio_graph() {
  if command -v translator-daemon >/dev/null 2>&1; then
    translator-daemon --audio-graph-cleanup >/dev/null || true
  else
    printf '%s\n' 'translator-daemon is not in PATH; audio graph cleanup skipped' >&2
  fi
}

stop_unit_and_cleanup() {
  if unit_file_loaded; then
    systemctl --user stop translator.service
  else
    printf '%s\n' 'translator.service is not installed; only audio graph cleanup will run' >&2
  fi
  cleanup_audio_graph
}

print_service_summary() {
  systemctl --user show translator.service \
    --property=LoadState \
    --property=ActiveState \
    --property=SubState \
    --property=MainPID \
    --property=Result \
    --no-pager
}

stop_unit_if_loaded() {
  if unit_file_loaded; then
    systemctl --user stop translator.service || true
  fi
}

disable_unit_if_loaded() {
  if unit_file_loaded; then
    systemctl --user disable translator.service || true
  fi
}

case "${1:-}" in
  _run-daemon)
    if [ "$#" -ne 3 ]; then
      exit 64
    fi
    run_daemon_with_service_environment "${2}" "${3}"
    ;;
  install)
    install_unit
    ;;
  up)
    start_unit_installing_if_needed
    wait_for_daemon_api
    ensure_ui_running
    print_service_summary
    ;;
  start)
    start_unit_installing_if_needed
    wait_for_daemon_api
    ensure_ui_running
    ;;
  stop)
    stop_unit_and_cleanup
    ;;
  down)
    stop_unit_and_cleanup
    print_service_summary
    ;;
  restart)
    stop_unit_if_loaded
    cleanup_audio_graph
    start_unit_installing_if_needed
    wait_for_daemon_api
    ensure_ui_running
    print_service_summary
    ;;
  status)
    print_service_summary
    systemctl --user status translator.service --no-pager
    ;;
  logs)
    log_lines="${2:-80}"
    case "${log_lines}" in
      ''|*[!0-9]*)
        printf '%s\n' 'logs line count must be a positive integer' >&2
        exit 64
        ;;
    esac
    journalctl --user-unit translator.service --no-pager -n "${log_lines}"
    ;;
  disable)
    stop_unit_if_loaded
    systemctl --user disable translator.service
    ;;
  uninstall)
    stop_unit_if_loaded
    disable_unit_if_loaded
    remove_command_if_owned
    rm -f -- "${unit_target}" "${autostart_target}"
    systemctl --user daemon-reload
    systemctl --user reset-failed translator.service || true
    cleanup_audio_graph
    ;;
  *)
    usage
    exit 64
    ;;
esac
