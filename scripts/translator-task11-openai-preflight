#!/usr/bin/env python3
"""Offline consent/key contract check; never reuse a live provider receipt."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
from pathlib import Path
from typing import Any
from uuid import uuid4

ROOT = Path(__file__).resolve().parents[1]
SIDECAR = ROOT / "sidecar"
if str(SIDECAR) not in sys.path:
    sys.path.insert(0, str(SIDECAR))

from translator_sidecar.openai_http import (  # noqa: E402
    API_ORIGIN,
    ASR_MODEL,
    MT_MODEL,
    TTS_MODEL,
    VOICE,
)
from translator_sidecar.openai_provider import (  # noqa: E402
    OpenAIRealtimeAdapter,
    OpenAIRealtimeConfig,
)
from translator_sidecar.provider_contract import (  # noqa: E402
    AudioDirection,
    Language,
    OpenProviderSession,
    PcmFormat,
    ProviderId,
    SampleFormat,
    TranslationMode,
    VoiceEngine,
    VoiceGender,
    VoiceProfile,
)

DEFAULT_REPORT = (
    Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    / "translator/openai/task11-openai-https-preflight.json"
)
SCHEMA_VERSION = "translator.task11-openai-https-preflight.v3"
MODEL_IDENTITIES = {"asr": ASR_MODEL, "mt": MT_MODEL, "tts": TTS_MODEL}


def utc_now() -> str:
    return dt.datetime.now(dt.UTC).isoformat()


def request(direction: AudioDirection) -> OpenProviderSession:
    source, target = (
        (Language.RU, Language.EN)
        if direction is AudioDirection.MICROPHONE
        else (Language.EN, Language.RU)
    )
    return OpenProviderSession(
        session_id=uuid4(),
        provider_id=ProviderId.OPENAI,
        direction_id=direction,
        source_language=source,
        target_language=target,
        mode=TranslationMode.STREAMING_FIRST,
        requested_input_format=PcmFormat(
            sample_rate_hz=16_000,
            channels=1,
            sample_format=SampleFormat.S16LE,
            frame_duration_ms=20,
        ),
        requested_output_format=PcmFormat(
            sample_rate_hz=16_000,
            channels=1,
            sample_format=SampleFormat.S16LE,
            frame_duration_ms=20,
        ),
        voice_profile=VoiceProfile(
            language=target,
            gender=VoiceGender.MALE,
            engine=VoiceEngine.OPENAI,
        ),
        debug_text_enabled=False,
    )


def build_report() -> dict[str, Any]:
    session = request(AudioDirection.MICROPHONE)
    cases = []
    for name, consent, environ in (
        ("cloud_opt_in_required", False, {"OPENAI_API_KEY": "credential-present"}),
        ("missing_credentials_safe_error", True, {}),
        (
            "audio_leaves_machine_visible_before_session",
            True,
            {"OPENAI_API_KEY": "credential-present"},
        ),
    ):
        result = OpenAIRealtimeAdapter(
            OpenAIRealtimeConfig(cloud_opt_in=consent), environ=environ
        ).preflight_open_session(session)
        cases.append({"case": name, **result.safe_report()})
    contract_passed = (
        cases[0]["safe_error_code"] == "cloud_not_enabled"
        and cases[0]["can_start"] is False
        and cases[1]["safe_error_code"] == "provider_auth_failed"
        and cases[1]["can_start"] is False
        and cases[2]["can_start"] is True
        and cases[2]["audio_leaves_machine"] is True
        and all(case["network_session_started"] is False for case in cases)
    )
    debt = {}
    for task, filename in (
        ("task7", "task7-live-human-round-trip.json"),
        ("task10", "task10-validation-report.json"),
    ):
        path = ROOT / "docs/benchmarks" / filename
        debt[f"{task}_debt_carried"] = {
            "canonical_evidence": str(path.relative_to(ROOT)),
            "status": "historical_evidence_only" if path.exists() else "unavailable",
        }
    return {
        "schema_version": SCHEMA_VERSION,
        "task": "Task 11: OpenAI HTTPS ASR/translation/speech provider",
        "generated_at": utc_now(),
        "provider_id": "openai",
        "transport": "https_asr_mt_streaming_tts",
        "api_origin": API_ORIGIN,
        "models": MODEL_IDENTITIES,
        "voice": VOICE,
        "preflight_contract_passed": contract_passed,
        "preflight_cases": cases,
        "task11_completed": False,
        "release_ready": False,
        "does_not_satisfy_task11_live_comparison": True,
        "network_probe": {"status": "not_run"},
        "synthetic_speech_comparison": {
            "status": "pending",
            "provider_id": "openai",
            "models": MODEL_IDENTITIES,
            "voice": VOICE,
            "sample_count_per_direction": 0,
            "simultaneous": False,
            "directions": {},
            "stored_audio": False,
            "stored_transcript_or_translation": False,
            "debug_text_enabled": False,
            "plaintext_credential_persisted": False,
            "safe_error_code": None,
        },
        "openai_sidecar_runtime": {
            "status": "not_probed_by_offline_preflight",
            "daemon_provider_pcm_format": "16000hz_mono_s16le_20ms",
            "tts_wire_pcm_format": "24000hz_mono_s16le",
        },
        "live_openai_comparison": {"status": "pending"},
        "real_app_openai_smoke": {"status": "not_run"},
        "combined_latency_gate": {
            "status": "not_measured",
            "at_least_one_provider_meets_usable_release_gate": None,
            "synthetic_single_sample_not_release_gate": True,
        },
        **debt,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--report", type=Path, default=DEFAULT_REPORT)
    args = parser.parse_args()
    if args.report.resolve().is_relative_to(ROOT):
        parser.error("report must be outside the source repository")
    report = build_report()
    args.report.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    args.report.write_text(
        json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    )
    print(args.report)
    return 0 if report["preflight_contract_passed"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
