#!/usr/bin/python3 -I
"""Launch the deterministic validator through a pinned isolated interpreter."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def _sanitized_environment() -> dict[str, str]:
    blocked = {"CDPATH", "ENV", "GLOBIGNORE", "PS4", "SHELLOPTS"}
    return {
        name: value
        for name, value in os.environ.items()
        if name not in blocked
        and not name.startswith("BASH_")
        and not name.startswith("PYTHON")
    }


def main() -> None:
    if sys.argv[1:] != ["deterministic"]:
        print("usage: ./scripts/translator-validate deterministic", file=sys.stderr)
        raise SystemExit(2)
    runner = Path(__file__).resolve().with_name("translator-test-manifest")
    if not runner.is_file() or runner.is_symlink():
        raise SystemExit("validation: trusted manifest runner is unavailable")
    argv = ["/usr/bin/python3", "-I", str(runner), "run"]
    os.execve(argv[0], argv, _sanitized_environment())


if __name__ == "__main__":
    main()
