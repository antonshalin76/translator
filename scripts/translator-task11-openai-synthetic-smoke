#!/usr/bin/env python3
from __future__ import annotations

import argparse
import asyncio
import datetime as dt
import json
import os
import sys
import time
from collections import Counter
from contextlib import closing
from pathlib import Path
from threading import Barrier, Thread
from typing import Any
from uuid import uuid4

ROOT = Path(__file__).resolve().parents[1]
SIDECAR = ROOT / "sidecar"
if str(SIDECAR) not in sys.path:
    sys.path.insert(0, str(SIDECAR))

from translator_sidecar.local.model_lease import VerifiedModelSource  # noqa: E402
from translator_sidecar.local.model_manifest import (  # noqa: E402
    ManifestError,
    load_manifest,
)
from translator_sidecar.local.tts import (  # noqa: E402
    PiperTts,
    PiperVoiceRegistry,
    TtsUnavailable,
    TtsUnsupported,
)
from translator_sidecar.openai_http import (  # noqa: E402
    API_ORIGIN,
    ASR_MODEL,
    MT_MODEL,
    TTS_MODEL,
    VOICE,
)
from translator_sidecar.openai_runtime import OpenAIRealtimeProvider  # noqa: E402
from translator_sidecar.provider_contract import (  # noqa: E402
    AudioDirection,
    CloseRequestReason,
    Language,
    OpenProviderSession,
    PcmFormat,
    PrivacySafeProviderError,
    ProviderAudioDelta,
    ProviderId,
    ProviderInputFrame,
    ProviderUtteranceFinal,
    SampleFormat,
    TranslationMode,
    UtteranceOutcome,
    VoiceEngine,
    VoiceGender,
    VoiceProfile,
)

REPORT_PATH = (
    Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    / "translator/openai/task11-openai-https-preflight.json"
)
SCHEMA_VERSION = "translator.task11-openai-https-preflight.v3"
MODEL_IDENTITIES = {"asr": ASR_MODEL, "mt": MT_MODEL, "tts": TTS_MODEL}
MANIFEST_PATH = ROOT / "models/manifest.json"
FRAME_DURATION_MS = 20
SAMPLE_RATE_HZ = 24_000
CONNECT_TIMEOUT_SECONDS = 10
OUTPUT_WAIT_SECONDS = 8
MAX_SPEECH_MS = 4_000
TAIL_SILENCE_MS = 400

VOICE_MODELS = {
    (Language.RU, VoiceGender.MALE): "piper-ru-dmitri-medium",
    (Language.EN, VoiceGender.MALE): "piper-en-ryan-medium",
}

DIRECTION_CONFIGS = {
    "ru_to_en": {
        "direction_id": AudioDirection.MICROPHONE,
        "source_language": Language.RU,
        "target_language": Language.EN,
        "sample": "Проверка канала связи.",
    },
    "en_to_ru": {
        "direction_id": AudioDirection.SPEAKER,
        "source_language": Language.EN,
        "target_language": Language.RU,
        "sample": "Connection path check.",
    },
}


def utc_now() -> str:
    return dt.datetime.now(dt.UTC).isoformat()


def read_report() -> dict[str, Any]:
    report = json.loads(REPORT_PATH.read_text())
    if (
        report.get("schema_version") != SCHEMA_VERSION
        or report.get("models") != MODEL_IDENTITIES
        or report.get("voice") != VOICE
        or report.get("api_origin") != API_ORIGIN
        or report.get("transport") != "https_asr_mt_streaming_tts"
        or report.get("preflight_contract_passed") is not True
    ):
        raise ValueError("current_https_preflight_required")
    return report


def write_report(report: dict[str, Any]) -> None:
    REPORT_PATH.write_text(
        json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    )


def request(config: dict[str, Any]) -> OpenProviderSession:
    return OpenProviderSession(
        session_id=uuid4(),
        provider_id=ProviderId.OPENAI,
        direction_id=config["direction_id"],
        source_language=config["source_language"],
        target_language=config["target_language"],
        mode=TranslationMode.STREAMING_FIRST,
        requested_input_format=PcmFormat(
            sample_rate_hz=SAMPLE_RATE_HZ,
            channels=1,
            sample_format=SampleFormat.S16LE,
            frame_duration_ms=FRAME_DURATION_MS,
        ),
        requested_output_format=PcmFormat(
            sample_rate_hz=SAMPLE_RATE_HZ,
            channels=1,
            sample_format=SampleFormat.S16LE,
            frame_duration_ms=FRAME_DURATION_MS,
        ),
        voice_profile=VoiceProfile(
            language=config["target_language"],
            gender=VoiceGender.MALE,
            engine=VoiceEngine.OPENAI,
        ),
        debug_text_enabled=False,
    )


def voice_profile(language: Language) -> VoiceProfile:
    return VoiceProfile(
        language=language,
        gender=VoiceGender.MALE,
        engine=VoiceEngine.PIPER,
    )


def build_tts() -> PiperTts:
    manifest = load_manifest(MANIFEST_PATH)
    voice_paths = {
        profile: VerifiedModelSource(manifest, model_id)
        for profile, model_id in VOICE_MODELS.items()
    }
    registry = PiperVoiceRegistry(voice_paths)
    try:
        return PiperTts(registry)
    except BaseException:
        registry.close()
        raise


def synthesize_frames(tts: PiperTts, config: dict[str, Any]) -> list[bytes]:
    source_language = config["source_language"]
    frames = list(
        tts.synthesize_frames(
            config["sample"],
            target_language=source_language,
            voice_profile=voice_profile(source_language),
            mode=TranslationMode.STREAMING_FIRST,
            output_sample_rate_hz=SAMPLE_RATE_HZ,
            output_channels=1,
            frame_duration_ms=FRAME_DURATION_MS,
        )
    )
    if not frames:
        raise TtsUnavailable("synthetic speech emitted no frames")
    max_frames = max(1, MAX_SPEECH_MS // FRAME_DURATION_MS)
    tail_frames = TAIL_SILENCE_MS // FRAME_DURATION_MS
    frame_bytes = SAMPLE_RATE_HZ * 2 * FRAME_DURATION_MS // 1000
    return frames[:max_frames] + [b"\x00" * frame_bytes for _ in range(tail_frames)]


def direction_metrics(
    name: str, config: dict[str, Any], frames: list[bytes]
) -> dict[str, Any]:
    return {
        "name": name,
        "source_language": config["source_language"].value,
        "target_language": config["target_language"].value,
        "sample_rate_hz": SAMPLE_RATE_HZ,
        "frame_duration_ms": FRAME_DURATION_MS,
        "planned_frame_count": len(frames),
        "sent_frame_count": 0,
        "sent_duration_ms": 0,
        "provider_session_opened": False,
        "response_completed": False,
        "nonzero_output_frames": 0,
        "output_audio_delta_count": 0,
        "first_output_audio_delta_ms": None,
        "first_output_after_eou_ms": None,
        "last_output_audio_delta_ms": None,
        "event_type_counts": Counter(),
        "safe_error_code": None,
        "status": "failed",
    }


def run_direction(
    name: str,
    config: dict[str, Any],
    frames: list[bytes],
    api_key: str,
    start_barrier: Barrier,
) -> dict[str, Any]:
    async def run() -> dict[str, Any]:
        metrics = direction_metrics(name, config, frames)
        session_request = request(config)
        finished = asyncio.Event()
        first_input_ns = None
        end_of_utterance_ns = None
        stream_id, utterance_id = uuid4(), uuid4()
        next_audio_sequence, last_event_sequence, terminal = 0, -1, False

        async def publish(batch, commit):
            nonlocal next_audio_sequence, last_event_sequence, terminal
            next_sequence, last_sequence, ended = (
                next_audio_sequence,
                last_event_sequence,
                terminal,
            )
            for event in batch:
                valid = (
                    event.session_id == session_request.session_id
                    and event.direction_id == session_request.direction_id
                    and event.event_sequence > last_sequence
                )
                last_sequence = event.event_sequence
                if isinstance(event, (ProviderAudioDelta, ProviderUtteranceFinal)):
                    valid = valid and (
                        first_input_ns is not None
                        and not ended
                        and event.stream_id == stream_id
                        and event.utterance_id == utterance_id
                    )
                if isinstance(event, ProviderAudioDelta):
                    valid = valid and (
                        event.sequence == next_sequence
                        and event.sample_rate_hz == SAMPLE_RATE_HZ
                        and event.channels == 1
                        and event.sample_format is SampleFormat.S16LE
                        and event.frame_duration_ms == FRAME_DURATION_MS
                        and len(event.pcm)
                        == SAMPLE_RATE_HZ * 2 * FRAME_DURATION_MS // 1000
                    )
                    next_sequence += 1
                elif isinstance(event, ProviderUtteranceFinal):
                    valid = valid and event.final_audio_sequence == (
                        next_sequence - 1 if next_sequence else None
                    )
                    valid = valid and (
                        event.outcome is not UtteranceOutcome.COMPLETED
                        or next_sequence > 0
                    )
                    ended = True
                if not valid:
                    metrics["safe_error_code"] = "inconsistent_provider_event"
                    raise ValueError("inconsistent_provider_event")
            next_audio_sequence, last_event_sequence, terminal = (
                next_sequence,
                last_sequence,
                ended,
            )
            for event in batch:
                kind = type(event).__name__
                metrics["event_type_counts"][kind] += 1
                if isinstance(event, ProviderAudioDelta):
                    if any(event.pcm):
                        metrics["nonzero_output_frames"] += 1
                    elapsed_ms = (time.perf_counter_ns() - first_input_ns) // 1_000_000
                    if metrics["first_output_audio_delta_ms"] is None:
                        metrics["first_output_audio_delta_ms"] = elapsed_ms
                        if end_of_utterance_ns is not None:
                            metrics["first_output_after_eou_ms"] = (
                                time.perf_counter_ns() - end_of_utterance_ns
                            ) // 1_000_000
                    metrics["last_output_audio_delta_ms"] = elapsed_ms
                    metrics["output_audio_delta_count"] += 1
                elif isinstance(event, PrivacySafeProviderError):
                    metrics["safe_error_code"] = event.code.value
                elif isinstance(event, ProviderUtteranceFinal):
                    metrics["response_completed"] = (
                        event.outcome is UtteranceOutcome.COMPLETED
                    )
                    finished.set()
            commit()

        provider = OpenAIRealtimeProvider(environ={"OPENAI_API_KEY": api_key})
        owner = provider.reserve_session(session_request, publish)
        try:
            async with asyncio.timeout(
                CONNECT_TIMEOUT_SECONDS + OUTPUT_WAIT_SECONDS + 15
            ):
                await owner.open()
                metrics["provider_session_opened"] = True
                await asyncio.to_thread(start_barrier.wait, CONNECT_TIMEOUT_SECONDS)
                first_input_ns = time.perf_counter_ns()
                for sequence, pcm in enumerate(frames):
                    if sequence == len(frames) - 1:
                        end_of_utterance_ns = time.perf_counter_ns()
                    await provider.submit_frame(
                        ProviderInputFrame(
                            session_id=session_request.session_id,
                            direction_id=session_request.direction_id,
                            stream_id=stream_id,
                            utterance_id=utterance_id,
                            sequence=sequence,
                            capture_monotonic_ns=time.monotonic_ns(),
                            sample_rate_hz=SAMPLE_RATE_HZ,
                            channels=1,
                            sample_format=SampleFormat.S16LE,
                            frame_duration_ms=FRAME_DURATION_MS,
                            source_language=session_request.source_language,
                            target_language=session_request.target_language,
                            mode=session_request.mode,
                            pcm=pcm,
                            end_of_utterance=sequence == len(frames) - 1,
                        )
                    )
                    metrics["sent_frame_count"] += 1
                    metrics["sent_duration_ms"] += FRAME_DURATION_MS
                    await asyncio.sleep(FRAME_DURATION_MS / 1000)
                await asyncio.wait_for(finished.wait(), OUTPUT_WAIT_SECONDS)
        except Exception:
            metrics["safe_error_code"] = (
                metrics["safe_error_code"] or "provider_run_failed"
            )
        finally:
            try:
                receipt = await owner.drain(CloseRequestReason.USER_STOP)
                if receipt.delivery_error is not None:
                    metrics["safe_error_code"] = receipt.delivery_error.value
            except Exception:
                metrics["safe_error_code"] = "provider_cleanup_failed"
            finally:
                try:
                    await provider.shutdown()
                except Exception:
                    metrics["safe_error_code"] = "provider_cleanup_failed"
        if (
            metrics["response_completed"]
            and metrics["nonzero_output_frames"] > 0
            and metrics["safe_error_code"] is None
        ):
            metrics["status"] = "passed"
        elif metrics["safe_error_code"] is None:
            metrics["safe_error_code"] = "no_completed_output_audio"
        metrics["event_type_counts"] = dict(
            sorted(metrics["event_type_counts"].items())
        )
        return metrics

    return asyncio.run(run())


def blocked_comparison(status: str, safe_error_code: str) -> dict[str, Any]:
    return {
        "status": status,
        "attempted_at": utc_now(),
        "provider_id": "openai",
        "models": MODEL_IDENTITIES,
        "voice": VOICE,
        "transport": "https_asr_mt_streaming_tts",
        "api_origin": API_ORIGIN,
        "sample_count_per_direction": 0,
        "simultaneous": False,
        "directions": {},
        "stored_audio": False,
        "stored_transcript_or_translation": False,
        "debug_text_enabled": False,
        "plaintext_credential_persisted": False,
        "safe_error_code": safe_error_code,
    }


def build_comparison(api_key: str) -> dict[str, Any]:
    if not api_key:
        return blocked_comparison("blocked_missing_credential", "provider_auth_failed")
    try:
        with closing(build_tts()) as tts:
            frames = {
                name: synthesize_frames(tts, config)
                for name, config in DIRECTION_CONFIGS.items()
            }
    except (ManifestError, TtsUnavailable, TtsUnsupported):
        return blocked_comparison(
            "blocked_synthetic_speech_unavailable",
            "synthetic_speech_fixture_unavailable",
        )

    start_barrier = Barrier(len(DIRECTION_CONFIGS))
    results: dict[str, dict[str, Any]] = {}
    threads = [
        Thread(
            target=lambda direction_name=name, direction_config=config: (
                results.__setitem__(
                    direction_name,
                    run_direction(
                        direction_name,
                        direction_config,
                        frames[direction_name],
                        api_key,
                        start_barrier,
                    ),
                )
            ),
            daemon=True,
        )
        for name, config in DIRECTION_CONFIGS.items()
    ]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join(CONNECT_TIMEOUT_SECONDS + OUTPUT_WAIT_SECONDS + 20)

    for name, config in DIRECTION_CONFIGS.items():
        if name not in results:
            results[name] = direction_metrics(name, config, frames[name])
            results[name]["safe_error_code"] = "direction_timeout"

    passed = sum(1 for result in results.values() if result["status"] == "passed")
    status = (
        "passed"
        if passed == len(DIRECTION_CONFIGS)
        else "partial"
        if passed
        else "failed"
    )
    return {
        "status": status,
        "attempted_at": utc_now(),
        "provider_id": "openai",
        "models": MODEL_IDENTITIES,
        "voice": VOICE,
        "transport": "https_asr_mt_streaming_tts",
        "api_origin": API_ORIGIN,
        "sample_count_per_direction": 1,
        "simultaneous": True,
        "input_fixture": {
            "kind": "local_piper_synthetic_speech",
            "sample_rate_hz": SAMPLE_RATE_HZ,
            "channels": 1,
            "sample_format": "s16le",
            "stored_audio": False,
            "stored_transcript_or_translation": False,
        },
        "directions": dict(sorted(results.items())),
        "stored_audio": False,
        "stored_transcript_or_translation": False,
        "debug_text_enabled": False,
        "plaintext_credential_persisted": False,
        "safe_error_code": None if status == "passed" else "direction_failed",
    }


def apply_comparison(
    report: dict[str, Any], comparison: dict[str, Any]
) -> dict[str, Any]:
    report["generated_at"] = utc_now()
    report["task11_completed"] = False
    report["release_ready"] = False
    report["does_not_satisfy_task11_live_comparison"] = True
    report["synthetic_speech_comparison"] = comparison
    report["real_app_openai_smoke"] = {"status": "not_run"}
    report["combined_latency_gate"] = {
        "status": "not_measured",
        "at_least_one_provider_meets_usable_release_gate": None,
        "synthetic_single_sample_not_release_gate": True,
    }
    if comparison["status"] == "passed":
        report["live_openai_comparison"] = {
            "status": "passed_synthetic_speech_comparison",
            "blocker": "credentialed real-app OpenAI route smoke is pending",
        }
        report["real_app_openai_smoke"] = {
            "status": "pending_after_synthetic_speech_comparison",
            "blocker": "credentialed real-app OpenAI route smoke is pending",
        }
        first_outputs = [
            direction["first_output_audio_delta_ms"]
            for direction in comparison["directions"].values()
            if direction.get("first_output_audio_delta_ms") is not None
        ]
        report["combined_latency_gate"] = {
            "status": "pending_real_app_openai_smoke",
            "at_least_one_provider_meets_usable_release_gate": None,
            "openai_synthetic_first_output_audio_delta_ms_max": (
                max(first_outputs) if first_outputs else None
            ),
            "synthetic_single_sample_not_release_gate": True,
        }
    else:
        report["live_openai_comparison"] = {
            "status": "pending_synthetic_speech_comparison",
            "blocker": "synthetic speech comparison did not pass",
        }
    return report


def main() -> int:
    global REPORT_PATH
    parser = argparse.ArgumentParser(
        description="Two-direction synthetic HTTPS smoke, not a release/quality gate."
    )
    parser.add_argument("--report", type=Path, default=REPORT_PATH)
    args = parser.parse_args()
    REPORT_PATH = args.report
    if REPORT_PATH.resolve().is_relative_to(ROOT):
        parser.error("report must be outside the source repository")
    report = read_report()
    comparison = build_comparison(os.environ.get("OPENAI_API_KEY", "").strip())
    report = apply_comparison(report, comparison)
    write_report(report)
    print(
        json.dumps(
            {
                "report": str(REPORT_PATH),
                "synthetic_speech_comparison_status": comparison["status"],
                "directions": {
                    name: {
                        "status": result["status"],
                        "output_audio_delta_count": result["output_audio_delta_count"],
                        "first_output_audio_delta_ms": result[
                            "first_output_audio_delta_ms"
                        ],
                        "safe_error_code": result["safe_error_code"],
                    }
                    for name, result in comparison.get("directions", {}).items()
                },
            },
            sort_keys=True,
        )
    )
    return 0 if comparison["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
