def _gate(
    command_id: str,
    argv: list[str],
    *,
    cwd: str = ".",
    env: dict[str, str] | None = None,
    timeout_seconds: int = DEFAULT_GATE_TIMEOUT_SECONDS,
) -> dict[str, Any]:
    return {
        "id": command_id,
        "cwd": cwd,
        "env": env or {},
        "argv": argv,
        "timeout_seconds": timeout_seconds,
    }


