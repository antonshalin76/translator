PREFLIGHT = r"""
import json, os, resource, socket

def effective_capabilities():
    with open("/proc/self/status", encoding="ascii") as status:
        return int(next(line.split()[1] for line in status
                        if line.startswith("CapEff:")), 16)

def has_default_route():
    try:
        with open('/proc/net/route', encoding='ascii') as routes:
            return any(line.split()[1] == '00000000' for line in list(routes)[1:])
    except (OSError, IndexError):
        return True

interfaces = [name for _, name in socket.if_nameindex() if name != 'lo']
host_audio = os.path.exists('/dev/snd')
host_runtime = os.path.exists('/run/user')
network = bool(interfaces) or has_default_route()
net_changed = os.readlink('/proc/self/ns/net') != os.environ['PARENT_NET_NS']
mount_changed = os.readlink('/proc/self/ns/mnt') != os.environ['PARENT_MNT_NS']
print(json.dumps({
    'isolated': net_changed and mount_changed and not (host_audio or host_runtime or network),
    'host_audio_access': host_audio,
    'host_runtime_access': host_runtime,
    'network_access': network,
    'non_loopback_interfaces': interfaces,
    'default_route': has_default_route(),
    'net_namespace_changed': net_changed,
    'mount_namespace_changed': mount_changed,
    'cap_net_admin': bool(effective_capabilities() & (1 << 12)),
    'effective_capabilities': effective_capabilities(),
    'cpu_affinity_count': len(os.sched_getaffinity(0)),
    'address_space_limit_bytes': resource.getrlimit(resource.RLIMIT_AS)[0],
}))
"""

