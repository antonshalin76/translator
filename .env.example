# Copy to .env for local manual runs. Do not commit real values.

# Optional cloud provider credential. Local provider does not need it.
OPENAI_API_KEY=

# Optional UI override. Must stay loopback-only.
TRANSLATOR_DAEMON_URL=http://127.0.0.1:47681

# Optional daemon-side local development overrides.
# TRANSLATOR_SIDECAR_ROOT=~/Source/translator/sidecar
# TRANSLATOR_PYTHON=~/Source/translator/sidecar/.venv/bin/python
# TRANSLATOR_HEADPHONE_SINK=
# TRANSLATOR_ENABLE_HEADPHONE_AEC=1
# TRANSLATOR_DISABLE_HEADPHONE_AEC=1

# Optional local provider/model test overrides.
# TRANSLATOR_ASR_MODEL_ID=faster-whisper-small
# TRANSLATOR_LOCAL_RUNTIME_MODE=unavailable
#
# Benchmark candidates are selected with script flags, not service env vars:
# ./scripts/translator-podcast-quality-debug --list-candidates

# Daemon-managed variables. Do not set these manually for normal runs:
# TRANSLATOR_SIDECAR_SOCKET
# TRANSLATOR_SIDECAR_TOKEN
# TRANSLATOR_SIDECAR_GENERATION
